{
  "name": "@mobile-input/controls",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./desktop.css": "./src/desktop.css",
    "./*": "./src/*.tsx",
    "./types": "./src/types.ts",
    "./capture-adapter": "./src/capture-adapter.ts",
    "./color-math": "./src/color-math.ts",
    "./sketch-geometry": "./src/sketch-geometry.ts"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "scripts": {
    "pack:library": "node scripts/pack-library.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "predev": "npm run pack:library",
    "prebuild": "npm run pack:library",
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "vite": "6.3.6",
    "typescript": "5.8.3",
    "tsx": "4.19.4",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/node": "22.19.0",
    "@playwright/test": "1.51.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "0.468.0"
  }
}
