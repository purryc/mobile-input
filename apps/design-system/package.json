    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.6",
    "tsx": "4.19.4"
  }
